{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nptel \"node --test tests/firestore.rules.test.mjs\"",
    "test:content-service": "firebase emulators:exec --only firestore --project demo-nptel \"node --test tests/content-service.test.mjs\"",
    "test:content-quality": "node --experimental-strip-types --test tests/content-quality.test.mjs",
    "test:accessibility": "node tests/accessibility.e2e.mjs",
    "test:performance": "node tests/performance.e2e.mjs",
    "test:e2e:admin": "node tests/admin.e2e.mjs",
    "test:e2e:learner": "node tests/learner.e2e.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "firebase": "^13.1.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.14.0",
    "firebase-admin": "^14.5.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
